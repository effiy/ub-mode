#!/usr/bin/env bash
# ============================================================================
# ub-quality — Unified launcher for UB-Mode quality gate tools
#
# Usage:
#   ub-quality crapper [args...]    CRAP score analysis
#   ub-quality dryer   [args...]    Duplicate code detection
#   ub-quality mutator [args...]    Mutation testing
#   ub-quality all     [root]       Run all three checks
#   ub-quality env                  Print environment info
#
# Available via PATH or symlink. Requires the ub-mode virtual environment.
# ============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_PYTHON="${SCRIPT_DIR}/../../.venv/bin/python3"

if [[ ! -x "$VENV_PYTHON" ]]; then
    echo "ub-quality: Virtual environment not found at ${VENV_PYTHON}" >&2
    echo "  Run: python3 -m venv ub-mode/.venv && ub-mode/.venv/bin/pip install -e ub-mode/tools" >&2
    exit 1
fi

print_help() {
    cat <<'EOF'
ub-quality — UB-Mode Quality Gate Tools

SUBCOMMANDS:
  crapper [options] [paths...]     Compute CRAP scores (complexity + coverage)
  dryer   [options] [paths...]     Detect structural code duplication
  mutator [options] [paths...]     Run mutation testing
  all     [root]                   Run all three checks sequentially
  env                              Print tool environment info

COMMON OPTIONS:
  --root <path>         Project root directory
  -s, --source-root     Walk specific source tree (may repeat)
  --json                Output as JSON
  -h, --help            Show tool-specific help

EXAMPLES:
  ub-quality crapper --root ./src
  ub-quality crapper --root . --threshold 10
  ub-quality dryer --root . --threshold 0.8
  ub-quality mutator --root . --test-command "pytest"
  ub-quality all /path/to/project
EOF
}

case "${1:-}" in
    crapper)
        shift
        exec "$VENV_PYTHON" -m ub_tools.crapper "$@"
        ;;
    dryer)
        shift
        exec "$VENV_PYTHON" -m ub_tools.dryer "$@"
        ;;
    mutator)
        shift
        exec "$VENV_PYTHON" -m ub_tools.mutator "$@"
        ;;
    all)
        ROOT="${2:-.}"
        echo "=== UB Quality Gate: ${ROOT} ==="
        echo ""
        echo "--- 1/3 CRAP Score (crapper) ---"
        "$VENV_PYTHON" -m ub_tools.crapper --root "$ROOT"
        echo ""
        echo "--- 2/3 Duplicate Detection (dryer) ---"
        "$VENV_PYTHON" -m ub_tools.dryer --root "$ROOT" --threshold 0.8
        echo ""
        echo "--- 3/3 Mutation Testing (mutator) ---"
        "$VENV_PYTHON" -m ub_tools.mutator --root "$ROOT" --operators invert-condition,remove-statement
        echo ""
        echo "=== Quality Gate Complete ==="
        ;;
    env)
        echo "UB-Mode Quality Gate Tools"
        echo "=========================="
        echo "  Virtual env:  $(dirname "$VENV_PYTHON")"
        echo "  Python:       $($VENV_PYTHON --version)"
        echo "  Package:      $($VENV_PYTHON -c "import ub_tools; print(ub_tools.__version__)")"
        echo ""
        echo "  crapper:    $($VENV_PYTHON -c "from ub_tools.crapper import main; print('✓ available')" 2>&1)"
        echo "  dryer:      $($VENV_PYTHON -c "from ub_tools.dryer import main; print('✓ available')" 2>&1)"
        echo "  mutator:    $($VENV_PYTHON -c "from ub_tools.mutator import main; print('✓ available')" 2>&1)"
        ;;
    -h|--help|help|"")
        print_help
        ;;
    *)
        echo "ub-quality: unknown subcommand '${1:-}'" >&2
        print_help
        exit 1
        ;;
esac